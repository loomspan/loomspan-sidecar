# Copy to production.env and protect it from other users. Replace deployment examples;
# leave SMTP fields empty when email delivery is not configured.
SIDECAR_IMAGE=loomspan-sidecar:sc5-local
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
SITE_HOST=sidecar.home.arpa
CADDY_CONFIG_FILE=./Caddyfile.internal
TLS_DIR=./secrets/tls
# For DNS mode, build Dockerfile.caddy-dns and set CADDY_IMAGE to that tag.
# CADDY_IMAGE=loomspan-caddy-cloudflare:local
# CF_API_TOKEN=store-in-protected-production-env-only
JWT_KEY_DIRECTORY=./secrets/execution-keys
JWT_AUDIENCE=loomspan-sidecar
# Base64 encoding of 32 random bytes; protect and back up separately from SQLite.
LOOMSPAN_SIDECAR_CREDENTIAL_KEY=
# File mode additionally requires mounting complete configuration and skill files.
LOOMSPAN_SIDECAR_CONFIGURATION_MODE=database
SETUP_TOKEN=
SMTP_FROM=
EXTERNAL_BASE_URL=https://sidecar.home.arpa:8443
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
