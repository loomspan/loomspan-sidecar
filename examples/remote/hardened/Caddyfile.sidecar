{
    admin off
    auto_https off
}

https://:8443 {
    tls /tls/sidecar-server.pem /tls/sidecar-server-key.pem {
        client_auth {
            mode require_and_verify
            trust_pool file /tls/group-ca.pem
        }
    }
    @execution path /v1/*
    handle @execution {
        reverse_proxy 127.0.0.1:8080 {
            lb_try_duration 0
        }
    }
    handle /actuator/health/readiness {
        reverse_proxy 127.0.0.1:8080 {
            lb_try_duration 0
        }
    }
    handle {
        respond 404
    }
}

http://:9080 {
    bind 127.0.0.1
    reverse_proxy https://app-proxy:8443 {
        header_up Host app-proxy:8443
        lb_try_duration 0
        transport http {
            tls_trust_pool file /tls/group-ca.pem
            tls_client_auth /tls/sidecar-client.pem /tls/sidecar-client-key.pem
            tls_server_name app-proxy
        }
    }
}
